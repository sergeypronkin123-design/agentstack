---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ToolCard from '@/components/ToolCard.astro';

const tools = await getCollection('tools');
const recipes = await getCollection('recipes');

const featured = tools.filter((t) =>
  ['claude-code', 'cursor', 'cline', 'aider'].includes(t.data.slug),
);
const moreTools = tools.filter((t) => !featured.includes(t));
const recentRecipes = recipes
  .sort((a, b) => (a.data.updated < b.data.updated ? 1 : -1))
  .slice(0, 4);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'AgentStack',
  description: 'Independent directory of AI coding tools and recipes for stacking them.',
  url: Astro.site?.toString(),
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: `${Astro.site}tools?q={search}` },
    'query-input': 'required name=search',
  },
};
---

<BaseLayout
  title="AgentStack — AI coding tools, organized"
  description="Independent directory of AI coding agents (Cursor, Claude Code, Cline, Aider…) with daily-updated facts and multi-tool recipes."
  schema={schema}
>
  <section class="text-center py-12 sm:py-16">
    <span class="inline-block px-3 py-1 rounded-full text-xs bg-accent-500/15 text-accent-400 border border-accent-500/30 mb-6">
      Updated daily · No pay-for-rank · {tools.length} tools indexed
    </span>
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight">
      AI coding tools,
      <span class="bg-gradient-to-r from-accent-400 to-accent-600 bg-clip-text text-transparent">organized</span>
    </h1>
    <p class="mt-4 text-lg text-slate-300 max-w-2xl mx-auto">
      Honest, current comparisons of every meaningful AI coding agent in 2026.
      Plus battle-tested recipes for stacking them in real workflows.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/tools" class="px-5 py-2.5 rounded-lg bg-accent-500 hover:bg-accent-600 transition-colors font-medium">
        Browse tools →
      </a>
      <a href="/recipes" class="px-5 py-2.5 rounded-lg border border-white/15 hover:bg-white/5 transition-colors font-medium">
        See recipes
      </a>
    </div>
  </section>

  <section class="mt-12">
    <div class="flex items-baseline justify-between mb-4">
      <h2 class="text-xl font-semibold">Featured tools</h2>
      <a href="/tools" class="text-sm text-accent-400 hover:underline">All {tools.length} →</a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      {featured.map((t) => (
        <ToolCard
          slug={t.data.slug}
          name={t.data.name}
          tagline={t.data.tagline}
          category={t.data.category}
          pricing={t.data.pricing}
          open_source={t.data.open_source}
        />
      ))}
    </div>
  </section>

  <section class="mt-12">
    <div class="flex items-baseline justify-between mb-4">
      <h2 class="text-xl font-semibold">Latest recipes</h2>
      <a href="/recipes" class="text-sm text-accent-400 hover:underline">All →</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      {recentRecipes.map((r) => (
        <a
          href={`/recipes/${r.slug}`}
          class="block bg-ink-800/60 border border-white/5 rounded-xl p-5 hover:border-accent-500/40 transition-colors group"
        >
          <div class="flex items-center gap-2 text-[11px] text-slate-500 mb-2">
            <span>{r.data.difficulty}</span>
            <span>·</span>
            <span>{r.data.time_minutes} min</span>
            <span>·</span>
            <span>{r.data.tools.join(' + ')}</span>
          </div>
          <h3 class="font-semibold text-white group-hover:text-accent-400 transition-colors">{r.data.title}</h3>
          <p class="text-sm text-slate-300 mt-2">{r.data.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="mt-12">
    <h2 class="text-xl font-semibold mb-4">More tools</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {moreTools.map((t) => (
        <ToolCard
          slug={t.data.slug}
          name={t.data.name}
          tagline={t.data.tagline}
          category={t.data.category}
          pricing={t.data.pricing}
          open_source={t.data.open_source}
        />
      ))}
    </div>
  </section>

  <section class="mt-16 text-center bg-ink-800/40 border border-white/5 rounded-2xl p-8">
    <h2 class="text-2xl font-bold">Why this site exists</h2>
    <p class="mt-3 text-slate-300 max-w-2xl mx-auto">
      Every other "best AI coding tools" article is sponsored, outdated, or both.
      We update from public sources every day, mark affiliate links transparently,
      and keep recipes only if they're battle-tested.
    </p>
    <a href="/about" class="inline-block mt-5 text-accent-400 hover:underline">Read how we work →</a>
  </section>
</BaseLayout>
