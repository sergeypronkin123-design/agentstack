---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  schema?: Record<string, unknown>;
}

const { title, description, ogImage, canonical, schema } = Astro.props;
const site = Astro.site?.toString() ?? 'https://agentstack.dev';
const url = canonical ?? new URL(Astro.url.pathname, site).toString();
const fullTitle = title.endsWith('AgentStack') ? title : `${title} — AgentStack`;
const og = ogImage ?? `${site}/og-default.png`;
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />

  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={og} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={og} />

  <meta name="google-site-verification" content="gOZswEeTwSKLHnTkhAg6N2q4euRhZ6yyoxrjbnSGH5s" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="AgentStack RSS" href="/rss.xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  {schema && (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  )}

  <slot name="head" />
</head>
<body class="min-h-screen gradient-bg">
  <Header />
  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <slot />
  </main>
  <Footer />
</body>
</html>
