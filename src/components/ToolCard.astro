---
interface Props {
  slug: string;
  name: string;
  tagline: string;
  category: string;
  pricing: { free_tier: boolean; paid_from_usd?: number };
  open_source: boolean;
}

const { slug, name, tagline, category, pricing, open_source } = Astro.props;
---

<a
  href={`/tools/${slug}`}
  class="block bg-ink-800/60 border border-white/5 rounded-xl p-5 hover:border-accent-500/40 hover:bg-ink-800 transition-all group"
>
  <div class="flex items-start justify-between gap-3">
    <div>
      <h3 class="font-semibold text-white group-hover:text-accent-400 transition-colors">
        {name}
      </h3>
      <span class="text-[11px] text-slate-500 uppercase tracking-wider">{category}</span>
    </div>
    <div class="flex flex-col items-end gap-1 shrink-0">
      {open_source && (
        <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">OSS</span>
      )}
      {pricing.free_tier ? (
        <span class="text-[10px] px-1.5 py-0.5 rounded bg-blue-500/15 text-blue-400 border border-blue-500/30">free tier</span>
      ) : pricing.paid_from_usd ? (
        <span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-500/15 text-amber-400 border border-amber-500/30">${pricing.paid_from_usd}+/mo</span>
      ) : null}
    </div>
  </div>
  <p class="text-sm text-slate-300 mt-2 line-clamp-2">{tagline}</p>
</a>
